# korail.py 헌팅 스크립트 + 통합 테스트용 환경변수
# 사용법: 본 파일을 `.env` 로 복사한 뒤 실제 값으로 채워라.
#   cp .env.example .env

# ===== 자격증명 (필수) =====
KORAIL_ID=
KORAIL_PW=

# 코레일이 매크로 감지("MACRO ERROR")를 발동하면 아래 두 값을 조정하라.
# Version 은 YYMMDDNNN 형식, 너무 오래된 값이면 거부된다. 현재 코레일톡 앱 버전
# 빌드 날짜와 비슷하게 맞추는 것이 안전하다.
#   예: 260101001 (2026-01-01), 260501001 (2026-05-01)
KORAIL_LOGIN_VERSION=
# User-Agent 도 너무 오래된 폰이면 매크로로 분류된다. 본인 휴대폰 모델로 맞추면 좋다.
# 형식: Dalvik/2.1.0 (Linux; U; Android <ver>; <model> Build/<build>)
KORAIL_USER_AGENT=

# ===== 헌팅 대상 (korail.py 실행 시 필수) =====
DEP=서울
ARV=부산
DEP_DATE=20260601
DEP_TIME=100000

# 좌석 타입. TrainType 상수명(KTX, SAEMAEUL, ITX_SAEMAEUL, ALL 등). 미지정 시 ALL
TRAIN_TYPE=KTX

# 어른 인원수. 기본 1
ADULT_COUNT=1

# polling 간격(초). 기본 2.0. 너무 짧으면 차단될 수 있음
POLL_INTERVAL=2.0

# ===== 알림 (선택) =====
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_TOKEN=

# ===== Telegram 봇 (bot.py 실행 시 필수) =====
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 본 chat_id 만 봇 사용 허용. /start 를 한 번 보내면 봇이 본인 chat_id 를 알려준다.
# (또는 https://api.telegram.org/bot<TOKEN>/getUpdates 호출)
TELEGRAM_AUTHORIZED_CHAT_ID=
# 헌팅 polling 간격(초). 너무 짧으면 차단될 수 있다. 기본 3
TELEGRAM_HUNT_INTERVAL=3

# ===== 통합 테스트 (선택) =====
# 1로 설정하면 실제 예약/취소 테스트가 실행된다. 진짜 예약이 만들어진다 — 주의!
KORAIL_RESERVE_TEST=0
