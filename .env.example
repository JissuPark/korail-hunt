# korail.py 헌팅 스크립트 + 통합 테스트용 환경변수
# 사용법: 본 파일을 `.env` 로 복사한 뒤 실제 값으로 채워라.
#   cp .env.example .env

# ===== 자격증명 (필수) =====
KORAIL_ID=
KORAIL_PW=

# 코레일이 매크로 감지("MACRO ERROR")를 발동하면 아래 두 값을 조정하라.
# Version 은 YYMMDDNNN 형식, 너무 오래된 값이면 거부된다. 현재 코레일톡 앱 버전
# 빌드 날짜와 비슷하게 맞추는 것이 안전하다.
#   예: 260101001 (2026-01-01), 260501001 (2026-05-01)
KORAIL_LOGIN_VERSION=
# User-Agent 도 너무 오래된 폰이면 매크로로 분류된다. 본인 휴대폰 모델로 맞추면 좋다.
# 형식: Dalvik/2.1.0 (Linux; U; Android <ver>; <model> Build/<build>)
KORAIL_USER_AGENT=
# 클라이언트 종류. 기본 'AD'(Android). 거부되면 'iOS' 등을 시도.
KORAIL_DEVICE=

# ===== 헌팅 대상 (korail.py 실행 시 필수) =====
DEP=서울
ARV=부산
DEP_DATE=20260601
DEP_TIME=100000

# 좌석 타입. TrainType 상수명(KTX, SAEMAEUL, ITX_SAEMAEUL, ALL 등). 미지정 시 ALL
TRAIN_TYPE=KTX

# 어른 인원수. 기본 1
ADULT_COUNT=1

# polling 간격(초). 기본 2.0. 너무 짧으면 차단될 수 있음
POLL_INTERVAL=2.0

# ===== 알림 (선택) =====
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_TOKEN=

# ===== Telegram 봇 (bot.py 실행 시 필수) =====
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 관리자 chat_id (쉼표 구분). 새 사용자의 접근 요청을 받아 버튼으로 승인/거부하고,
# /users 로 목록 조회와 권한 해제를 할 수 있다. 관리자는 항상 봇을 쓸 수 있다.
# 처음엔 비워두고 봇을 띄운 뒤 /start 를 보내면 본인 chat_id 를 알려준다.
TELEGRAM_ADMIN_CHAT_IDS=
# 승인 절차 없이 항상 허용할 chat_id (쉼표 구분). 보통 비워둔다 —
# 사용자 추가는 관리자 승인으로 하는 게 맞다. 이걸 고치면 재시작이 필요하고,
# 재시작하면 전원의 코레일 로그인 세션이 날아간다.
TELEGRAM_ALLOWED_CHAT_IDS=
# (구버전 호환) 단일 chat_id. 위 고정 허용 목록에 합쳐진다.
TELEGRAM_AUTHORIZED_CHAT_ID=
# 헌팅 polling 간격(초). 너무 짧으면 차단될 수 있다. 기본 3
TELEGRAM_HUNT_INTERVAL=3
# 재시작 안내용 스냅샷 파일 경로. chat_id 와 헌팅 라벨만 들어가고
# 자격증명은 절대 기록되지 않는다. 기본 .bot_state.json
BOT_STATE_FILE=
# 승인된 사용자 목록 파일 경로. chat_id 와 표시 이름만 들어간다. 기본 .bot_users.json
# 재배포해도 승인 목록이 유지되도록, 컨테이너로 띄운다면 볼륨으로 빼라.
BOT_USERS_FILE=

# ===== 세션 핸드오프 (선택) =====
# 설정하면 재배포·재시작 시 로그인 세션을 넘겨서 사용자가 다시 /login 하지 않아도 된다.
# 정상 종료 때만 암호화 파일로 쓰고, 기동 직후 복원하면서 즉시 삭제한다.
# 비워두면 기능이 꺼지고 재시작마다 전원 재로그인이다.
#
# 아무 문자열이나 넣으면 SHA-256 으로 32바이트 키를 만든다. 길고 무작위일수록 좋다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 이 값을 바꾸면 기존 핸드오프 파일은 복호화 실패로 폐기된다 (동작엔 지장 없음).
SESSION_HANDOFF_KEY=
# 핸드오프 파일 유효시간(초). 기본 300. 봇이 이보다 오래 죽어 있었다면
# 파일이 남아 있어도 거부하고 재로그인을 요구한다.
SESSION_HANDOFF_TTL=300
# 핸드오프 파일 경로. 기본 .bot_handoff.enc
BOT_HANDOFF_FILE=

# 봇은 chat 별로 각자의 코레일 계정을 쓴다. 텔레그램에서 /login 으로 입력하며,
# 자격증명은 프로세스 메모리에만 보관된다 — 위의 KORAIL_ID/KORAIL_PW 는 봇이
# 쓰지 않는다 (korail.py 헌팅 스크립트와 통합 테스트 전용).
# 봇을 재시작하면 모든 세션이 사라지고 각자 /login 을 다시 해야 한다.

# ===== 통합 테스트 (선택) =====
# 1로 설정하면 실제 예약/취소 테스트가 실행된다. 진짜 예약이 만들어진다 — 주의!
KORAIL_RESERVE_TEST=0
