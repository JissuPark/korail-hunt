# korail.py 헌팅 스크립트 + 통합 테스트용 환경변수
# 사용법: 본 파일을 `.env` 로 복사한 뒤 실제 값으로 채워라.
#   cp .env.example .env

# ===== 자격증명 (필수) =====
KORAIL_ID=
KORAIL_PW=

# 코레일이 매크로 감지("MACRO ERROR")를 발동하면 아래 두 값을 조정하라.
# Version 은 YYMMDDNNN 형식, 너무 오래된 값이면 거부된다. 현재 코레일톡 앱 버전
# 빌드 날짜와 비슷하게 맞추는 것이 안전하다.
#   예: 260101001 (2026-01-01), 260501001 (2026-05-01)
KORAIL_LOGIN_VERSION=
# User-Agent 도 너무 오래된 폰이면 매크로로 분류된다. 본인 휴대폰 모델로 맞추면 좋다.
# 형식: Dalvik/2.1.0 (Linux; U; Android <ver>; <model> Build/<build>)
KORAIL_USER_AGENT=
# 클라이언트 종류. 기본 'AD'(Android). 거부되면 'iOS' 등을 시도.
KORAIL_DEVICE=

# ===== 헌팅 대상 (korail.py 실행 시 필수) =====
DEP=서울
ARV=부산
DEP_DATE=20260601
DEP_TIME=100000

# 좌석 타입. TrainType 상수명(KTX, SAEMAEUL, ITX_SAEMAEUL, ALL 등). 미지정 시 ALL
TRAIN_TYPE=KTX

# 어른 인원수. 기본 1
ADULT_COUNT=1

# polling 간격(초). 기본 2.0. 너무 짧으면 차단될 수 있음
POLL_INTERVAL=2.0

# ===== 알림 (선택) =====
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_TOKEN=

# ===== Telegram 봇 (bot.py 실행 시 필수) =====
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 허용된 chat_id 들 (콤마 구분, 멀티유저 지원). 본 ID 들만 봇 사용 가능.
# 본인 chat_id 모를 때: 비워두고 봇에 메시지를 보내면 본인 chat_id 가 안내된다.
# (또는 https://api.telegram.org/bot<TOKEN>/getUpdates 직접 호출)
# 단일 ID 만 쓸 거면 TELEGRAM_AUTHORIZED_CHAT_ID (단수) 도 그대로 인식된다.
TELEGRAM_AUTHORIZED_CHAT_IDS=
# 헌팅 polling 간격(초). 너무 짧으면 차단될 수 있다. 기본 3
TELEGRAM_HUNT_INTERVAL=3

# ===== 멀티유저 자격증명 저장 (bot.py 필수) =====
# 각 사용자의 코레일 ID/PW 를 암호화해 저장하는 데 쓰는 32바이트 base64 키.
# 분실하면 저장된 자격증명을 복호화할 수 없다. 절대 공개 금지.
# 새 키 생성: python -c "from korail2.storage import generate_key; print(generate_key())"
BOT_STORAGE_KEY=
# 암호화 저장소 파일 경로. 기본 ./bot_storage.enc
BOT_STORAGE_PATH=bot_storage.enc

# ===== 통합 테스트 (선택) =====
# 1로 설정하면 실제 예약/취소 테스트가 실행된다. 진짜 예약이 만들어진다 — 주의!
KORAIL_RESERVE_TEST=0
