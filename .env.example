# korail.py 헌팅 스크립트 + 통합 테스트용 환경변수
# 사용법: 본 파일을 `.env` 로 복사한 뒤 실제 값으로 채워라.
#   cp .env.example .env

# ===== 자격증명 (필수) =====
KORAIL_ID=
KORAIL_PW=

# ===== 헌팅 대상 (korail.py 실행 시 필수) =====
DEP=서울
ARV=부산
DEP_DATE=20260601
DEP_TIME=100000

# 좌석 타입. TrainType 상수명(KTX, SAEMAEUL, ITX_SAEMAEUL, ALL 등). 미지정 시 ALL
TRAIN_TYPE=KTX

# 어른 인원수. 기본 1
ADULT_COUNT=1

# polling 간격(초). 기본 2.0. 너무 짧으면 차단될 수 있음
POLL_INTERVAL=2.0

# ===== 알림 (선택) =====
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_TOKEN=

# ===== Telegram 봇 (bot.py 실행 시 필수) =====
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# 본 chat_id 만 봇 사용 허용. /start 를 한 번 보내면 봇이 본인 chat_id 를 알려준다.
# (또는 https://api.telegram.org/bot<TOKEN>/getUpdates 호출)
TELEGRAM_AUTHORIZED_CHAT_ID=
# 헌팅 polling 간격(초). 너무 짧으면 차단될 수 있다. 기본 3
TELEGRAM_HUNT_INTERVAL=3

# ===== 통합 테스트 (선택) =====
# 1로 설정하면 실제 예약/취소 테스트가 실행된다. 진짜 예약이 만들어진다 — 주의!
KORAIL_RESERVE_TEST=0
